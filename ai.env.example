# ai.env — Configuration for ai.sh
# Uncomment and edit to override defaults.

# AI_DIR — Base directory (default: auto-detected from ai.sh location)
# AI_DIR="/Users/p/Development/tools/ai"

# AI_LOG_DIR — Server log directory (default: $AI_DIR/logs)
# AI_LOG_DIR="${AI_DIR}/logs"

# AI_STATE_DIR — State and PID files (default: ~/.local/state)
# AI_STATE_DIR="${HOME}/.local/state"

# AI_PORT — oMLX server port (default: 10081)
# AI_PORT=10081

# ── oMLX server (local mode) ─────────────────────────────────────────
# OMLX_BIN — oMLX binary (default: ~/.omlx/venv/bin/omlx, else `omlx` on PATH)
# OMLX_BIN="${HOME}/.omlx/venv/bin/omlx"
# OMLX_MODEL_DIR — dir oMLX discovers models from (default: ~/.omlx/models)
# OMLX_MODEL_DIR="${HOME}/.omlx/models"
# OMLX_CACHE_DIR — paged SSD KV-cache dir (default: ~/.omlx/cache)
# OMLX_CACHE_DIR="${HOME}/.omlx/cache"
# OMLX_HOT_CACHE — in-RAM hot KV tier size (default: 12GB)
# OMLX_HOT_CACHE="12GB"
# OMLX_MEMORY_GUARD_GB — memory ceiling in GB (default: 48; raise on 128 GB)
# OMLX_MEMORY_GUARD_GB=48
# OMLX_MAX_CONCURRENT — max concurrent requests / continuous batching (default: 4)
# OMLX_MAX_CONCURRENT=4

# ── OOZ remote endpoint (used by `ai -ooz`) ──────────────────────────
# ai -ooz opens an SSH tunnel to a remote OpenAI-compatible server and
# points opencode at it. Fill these in your real (gitignored) ai.env.
# OOZ_SSH_HOST — remote host
# OOZ_SSH_HOST="example.com"
# OOZ_SSH_USER — SSH username
# OOZ_SSH_USER="user"
# OOZ_SSH_PORT — SSH port (default: 22)
# OOZ_SSH_PORT=22
# OOZ_LOCAL_PORT — local port opencode connects to (default: 8089)
# OOZ_LOCAL_PORT=8089
# OOZ_REMOTE — remote host:port the endpoint listens on (default: 127.0.0.1:8080)
# OOZ_REMOTE="127.0.0.1:8080"
# OOZ_MODEL — model id served by the remote (must match opencode.json provider
#             "ooz"). Empty → auto-detect via /v1/models.
# OOZ_MODEL="Qwen3.6-35B-A3B-GGUF:Q8_0"
