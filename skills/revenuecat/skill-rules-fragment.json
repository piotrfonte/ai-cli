{
  "revenuecat": {
    "type": "domain",
    "enforcement": "suggest",
    "priority": "high",
    "promptTriggers": {
      "keywords": [
        "revenuecat",
        "revenue cat",
        "subscription",
        "MRR",
        "monthly recurring revenue",
        "churn",
        "active subscribers",
        "in-app purchase",
        "IAP",
        "entitlement",
        "offering",
        "paywall",
        "storekit",
        "play billing",
        "RC_API_KEY",
        "rc-api"
      ],
      "intentPatterns": [
        "query.*subscription",
        "get.*mrr",
        "check.*entitlement",
        "lookup.*customer",
        "subscription.*analytics",
        "revenuecat.*api",
        "list.*offerings",
        "refund.*subscription"
      ]
    },
    "fileTriggers": {
      "pathPatterns": ["**/.env*", "**/scripts/rc-api.sh"],
      "contentPatterns": [
        "RC_API_KEY",
        "revenuecat",
        "RevenueCat",
        "api.revenuecat.com"
      ]
    }
  }
}
