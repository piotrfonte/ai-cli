{
  "react-query": {
    "type": "domain",
    "enforcement": "suggest",
    "priority": "high",
    "promptTriggers": {
      "keywords": [
        "react-query",
        "useQuery",
        "useMutation",
        "QueryClient",
        "invalidateQueries",
        "staleTime",
        "cacheTime",
        "queryKey",
        "QueryClientProvider",
        "useInfiniteQuery",
        "usePrefetchQuery"
      ],
      "intentPatterns": [
        "fetch.*data",
        "query.*api",
        "mutate.*data",
        "cache.*invalidat",
        "optimistic.*update",
        "server.*state"
      ]
    },
    "fileTriggers": {
      "pathPatterns": [
        "**/queries/**",
        "**/hooks/use*Query.ts",
        "**/hooks/use*Mutation.ts",
        "**/api/**"
      ],
      "contentPatterns": [
        "import.*react-query",
        "useQuery\\(",
        "useMutation\\(",
        "QueryClient",
        "invalidateQueries",
        "useInfiniteQuery"
      ]
    }
  }
}
