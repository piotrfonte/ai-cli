{
  "redux-toolkit": {
    "type": "domain",
    "enforcement": "suggest",
    "priority": "high",
    "promptTriggers": {
      "keywords": [
        "redux",
        "createSlice",
        "configureStore",
        "useDispatch",
        "useSelector",
        "thunk",
        "PayloadAction",
        "createAsyncThunk",
        "createEntityAdapter",
        "extraReducers",
        "@reduxjs/toolkit",
        "react-redux",
        "RootState",
        "AppDispatch",
        "rejectWithValue",
        "createSelector",
        "EntityState",
        "EntityAdapter",
        "reducer",
        "slice",
        "middleware",
        "getDefaultMiddleware"
      ],
      "intentPatterns": [
        "create.*slice",
        "setup.*store",
        "add.*reducer",
        "create.*thunk",
        "manage.*state.*redux",
        "configure.*store",
        "add.*middleware",
        "create.*selector",
        "normalize.*state",
        "dispatch.*action",
        "handle.*async.*action",
        "add.*extra.*reducer"
      ]
    },
    "fileTriggers": {
      "pathPatterns": [
        "**/redux/**",
        "**/*Slice.ts",
        "**/*Slice.tsx",
        "**/*slice.ts",
        "**/*slice.tsx",
        "**/slices/**",
        "**/reducers/**",
        "**/thunks/**",
        "**/selectors/**"
      ],
      "contentPatterns": [
        "import.*@reduxjs/toolkit",
        "import.*react-redux",
        "createSlice\\(",
        "configureStore\\(",
        "createAsyncThunk\\(",
        "useDispatch",
        "useSelector",
        "createEntityAdapter\\(",
        "PayloadAction",
        "createSelector\\("
      ]
    }
  }
}
