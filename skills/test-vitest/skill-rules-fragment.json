{
  "test-vitest": {
    "type": "domain",
    "enforcement": "suggest",
    "priority": "high",
    "promptTriggers": {
      "keywords": [
        "vitest",
        "testing-library",
        "react-testing-library",
        "user-event",
        "getByRole",
        "screen",
        "render",
        "describe",
        "expect",
        "vi.fn",
        "vi.mock",
        "vi.spyOn",
        "test file",
        "spec file",
        "jest-dom"
      ],
      "intentPatterns": [
        "write.*test",
        "test.*component",
        "unit.*test",
        "integration.*test",
        "mock.*module",
        "test.*hook"
      ]
    },
    "fileTriggers": {
      "pathPatterns": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx"
      ],
      "contentPatterns": [
        "import.*vitest",
        "import.*@testing-library",
        "from 'vitest'",
        "vi\\.fn\\(",
        "vi\\.mock\\(",
        "screen\\.getBy"
      ]
    }
  }
}
