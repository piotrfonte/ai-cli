{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": ["opencode", "gitlab"],
  "autoupdate": "notify",
  "plugin": ["opencode-mem"],
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "whitelist": ["zai-org/glm-4.7-flash", "prism-ml/bonsai-27b"],
      "models": {
        "zai-org/glm-4.7-flash": {
          "name": "GLM 4.7 Flash 6-bit (LM Studio)",
          "temperature": false,
          "options": {
            "stop": ["<|user|>", "<|observation|>"]
          },
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "prism-ml/bonsai-27b": {
          "name": "Ternary Bonsai 27B 2-bit (LM Studio)",
          "temperature": false,
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    },
    "mlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MLX Local",
      "options": {
        "baseURL": "http://127.0.0.1:10081/v1",
        "apiKey": "mlx",
        "logLevel": "ERROR",
        "timeout": 600000,
        "chunkTimeout": 600000
      },
      "models": {
        "lmstudio-community/GLM-4.7-Flash-MLX-6bit": {
          "name": "GLM 4.7 Flash 6-bit",
          "temperature": false,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "prism-ml/Ternary-Bonsai-27B-mlx-2bit": {
          "name": "Ternary Bonsai 27B 2-bit",
          "temperature": false,
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "mlx-community/Muse-Glimmer-30B-4bit": {
          "name": "Muse Glimmer 30B 4-bit",
          "temperature": false,
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "zai/glm-5.2",
  "default_agent": "build",
  "agent": {
    "title": {
      "disable": true
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", "build/**", ".next/**", "*.log"]
  },
  "permission": {
    "bash": {
      "gitlab *": "ask",

      "git status": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git blame *": "allow",
      "git fetch *": "allow",
      "git add *": "allow",
      "git commit *": "allow",

      "git merge *": "ask",
      "git cherry-pick *": "ask",
      "git tag *": "ask",
      "git remote *": "ask",
      "git stash *": "ask",

      "git reset --hard *": "deny",
      "git clean *": "deny",
      "git checkout *": "deny",
      "git restore *": "deny",
      "git rebase *": "deny",
      "git branch -D *": "deny",
      "git push *": "deny",
      "git filter-branch *": "deny",
      "git gc *": "deny",
      "git prune *": "deny"
    },
    "doom_loop": "allow",
    "task": "ask"
  },
  "mcp": {
    "smart-coding": {
      "type": "local",
      "enabled": true,
      "command": [
        "/Users/p/.smart-coding-omlx/node_modules/.bin/smart-coding-mcp",
        "--workspace",
        "."
      ],
      "environment": {
        "SMART_CODING_SMART_INDEXING": "true",
        "SMART_CODING_WATCH_FILES": "true",
        "SMART_CODING_EMBEDDING_MODEL": "bge-m3",
        "SMART_CODING_EMBEDDING_API_URL": "http://127.0.0.1:10081/v1",
        "SMART_CODING_EMBEDDING_API_KEY": "mlx",
        "SMART_CODING_EMBEDDING_API_MODEL": "bge-m3"
      },
      "timeout": 60000
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect",
        "--channel=stable"
      ],
      "enabled": false
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8192
  }
}
