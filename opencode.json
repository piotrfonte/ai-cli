{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": ["opencode"],
  "autoupdate": "notify",
  "plugin": ["opencode-mem"],
  "provider": {
    "mlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MLX Local",
      "options": {
        "baseURL": "http://127.0.0.1:10081/v1",
        "apiKey": "mlx",
        "logLevel": "ERROR",
        "timeout": 600000,
        "chunkTimeout": 600000
      },
      "models": {
        "mlx-community/Qwen3.6-35B-A3B-6bit": {
          "name": "Qwen 3.6 35B-A3B",
          "temperature": false,
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    },
    "ooz": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OOZ Remote",
      "options": {
        "baseURL": "http://127.0.0.1:8089/v1",
        "apiKey": "ooz",
        "logLevel": "ERROR",
        "timeout": 600000,
        "chunkTimeout": 600000
      },
      "models": {
        "Qwen3.6-35B-A3B-GGUF:Q8_0": {
          "name": "Qwen 3.6 35B-A3B (Q8_0, remote)",
          "temperature": false,
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "mlx/mlx-community/Qwen3.6-35B-A3B-6bit",
  "default_agent": "build",
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", "build/**", ".next/**", "*.log"]
  },
  "permission": {
    "bash": {
      "gitlab *": "ask",

      "git status": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git blame *": "allow",
      "git fetch *": "allow",
      "git add *": "allow",
      "git commit *": "allow",

      "git merge *": "ask",
      "git cherry-pick *": "ask",
      "git tag *": "ask",
      "git remote *": "ask",
      "git stash *": "ask",

      "git reset --hard *": "deny",
      "git clean *": "deny",
      "git checkout *": "deny",
      "git restore *": "deny",
      "git rebase *": "deny",
      "git branch -D *": "deny",
      "git push *": "deny",
      "git filter-branch *": "deny",
      "git gc *": "deny",
      "git prune *": "deny"
    },
    "doom_loop": "allow"
  },
  "mcp": {
    "smart-coding": {
      "type": "local",
      "enabled": true,
      "command": ["/Users/p/.smart-coding-omlx/node_modules/.bin/smart-coding-mcp", "--workspace", "."],
      "environment": {
        "SMART_CODING_SMART_INDEXING": "true",
        "SMART_CODING_WATCH_FILES": "true",
        "SMART_CODING_EMBEDDING_MODEL": "bge-m3",
        "SMART_CODING_EMBEDDING_API_URL": "http://127.0.0.1:10081/v1",
        "SMART_CODING_EMBEDDING_API_KEY": "mlx",
        "SMART_CODING_EMBEDDING_API_MODEL": "bge-m3"
      },
      "timeout": 60000
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect",
        "--channel=stable"
      ],
      "enabled": false
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8192
  }
}
